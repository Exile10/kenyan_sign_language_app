<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <ImageView
            android:id="@+id/image_view_sign"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/text_expected_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/text_result_indicator"
            app:layout_constraintStart_toEndOf="@id/image_view_sign"
            app:layout_constraintTop_toTopOf="@id/image_view_sign"
            tools:text="Expected: Sign A" />

        <TextView
            android:id="@+id/text_predicted_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/text_result_indicator"
            app:layout_constraintStart_toStartOf="@id/text_expected_label"
            app:layout_constraintTop_toBottomOf="@id/text_expected_label"
            tools:text="Predicted: Sign A" />

        <TextView
            android:id="@+id/text_confidence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/text_result_indicator"
            app:layout_constraintStart_toStartOf="@id/text_expected_label"
            app:layout_constraintTop_toBottomOf="@id/text_predicted_label"
            tools:text="Confidence: 0.95" />

        <TextView
            android:id="@+id/text_inference_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/text_result_indicator"
            app:layout_constraintStart_toStartOf="@id/text_expected_label"
            app:layout_constraintTop_toBottomOf="@id/text_confidence"
            tools:text="Inference time: 240ms" />

        <TextView
            android:id="@+id/text_timestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/text_result_indicator"
            app:layout_constraintStart_toStartOf="@id/text_expected_label"
            app:layout_constraintTop_toBottomOf="@id/text_inference_time"
            tools:text="2023-10-15 14:30:00" />

        <TextView
            android:id="@+id/text_result_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/button_delete_validation"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="✓"
            tools:textColor="@android:color/holo_green_dark" />

        <ImageButton
            android:id="@+id/button_delete_validation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete validation record"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@android:drawable/ic_menu_delete" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
